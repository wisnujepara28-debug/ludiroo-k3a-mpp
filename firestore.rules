rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection probe
    match /test/connection {
      allow read, write: if true;
    }

    // Armada Kapal
    match /vessels/{vesselId} {
      allow read, write: if true;
    }

    // Jadwal Pelayaran
    match /voyages/{voyageId} {
      allow read, write: if true;
    }

    // Manifest Kargo B/L
    match /manifests/{manifestId} {
      allow read, write: if true;
    }

    // Log Operasional
    match /operational_logs/{logId} {
      allow read, write: if true;
    }

    // Multi-User Live Presence (Online Users Connected)
    match /online_users/{userId} {
      allow read, write: if true;
    }

    // Live Activity Stream (Updates broadcast across all connected clients)
    match /live_activities/{activityId} {
      allow read, write: if true;
    }
  }
}
